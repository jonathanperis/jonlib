# raylib [textures] example - raw data, ported to Jonlib.
# Adapted from raylib 6.0 examples/textures/textures_raw_data.c (zlib/libpng,
# Copyright (c) 2015-2025 Ramon Santamaria (@raysan5)); see LICENSES/raylib.txt.
# The Fudesumi sprite is raylib's example resource by Eiden Marsal, read in
# place from the pinned raylib checkout.
#
# A raw RGBA image (LoadImageRaw) and a checkerboard built pixel by pixel.
# The example fills ORANGE where ((x/32 + y/32)/1)%2 == 0 and GOLD
# elsewhere, GenImageChecked(960, 480, 32, 32, ORANGE, GOLD)'s rule, so the
# port builds it with Surface.create_checked. See docs/DRIVER.md.
import Base
import ../jonlib.bend as J
import ../jonmath.bend as M

type State is Type:
  State{fudesumi: Maybe<J.Texture>, checked: Maybe<J.Texture>}

def update(+core: J.Core, state: State) -> J.Core & State:
  (core, state)

def kept(r: J.Frame & J.Texture) -> J.Frame & Maybe<J.Texture>:
  (frame, texture) = r
  (frame, Some{texture})

def draw.at(frame: J.Frame, texture: Maybe<J.Texture>, +x: F32, +y: F32, +tint: U32) -> J.Frame & Maybe<J.Texture>:
  match texture:
    case None{}: (frame, None{})
    case Some{t}: kept(J.Draw.texture(frame, t, x, y, tint))

def draw.texts(+core: J.Core, checked: Maybe<J.Texture>, r: J.Frame & Maybe<J.Texture>) -> J.Core & (State & J.Frame):
  (frame, fudesumi) = r
  f1 = J.Draw.text(frame, "CHECKED TEXTURE ", 84.0, 85.0, 30.0, J.Color.BROWN())
  f2 = J.Draw.text(f1, "GENERATED by CODE", 72.0, 148.0, 30.0, J.Color.BROWN())
  f3 = J.Draw.text(f2, "and RAW IMAGE LOADING", 46.0, 210.0, 30.0, J.Color.BROWN())
  (core, (State{fudesumi, checked}, J.Draw.text(f3, "(c) Fudesumi sprite by Eiden Marsal", 310.0, 430.0, 10.0, J.Color.BROWN())))

def draw.second(+core: J.Core, fudesumi: Maybe<J.Texture>, r: J.Frame & Maybe<J.Texture>) -> J.Core & (State & J.Frame):
  (frame, checked) = r
  draw.texts(core, checked, draw.at(frame, fudesumi, 430.0, F32.neg(30.0), J.Color.WHITE()))

# DrawTexture(checked, 400 - 960/2, 225 - 480/2, Fade(WHITE, 0.5)), then fudesumi at (430, -30).
def draw(+core: J.Core, state: State, frame: J.Frame) -> J.Core & (State & J.Frame):
  State{fudesumi, checked} = state
  draw.second(core, fudesumi, draw.at(J.Frame.clear_background(frame, J.Color.RAYWHITE()), checked, F32.neg(80.0), F32.neg(15.0), J.Color.with_alpha(J.Color.WHITE(), 0.5)))

# No libm call: the profile argument is the examples' common signature.
def program(+libm: M.Libm) -> J.Program<State>:
  J.Program{core => state => update(core, state), core => state => frame => draw(core, state, frame)}

def upload(frame: J.Frame, image: Maybe<J.Surface>) -> J.Frame & Maybe<J.Texture>:
  match image:
    case None{}: (frame, None{})
    case Some{i}: J.Texture.load_from_image(frame, i)

def setup.done(+core: J.Core, fudesumi: Maybe<J.Texture>, r: J.Frame & Maybe<J.Texture>) -> J.Core & (J.Frame & State):
  (frame, checked) = r
  (J.Core.set_target_fps(core, 60), (frame, State{fudesumi, checked}))

def setup.raw(+core: J.Core, r: J.Frame & Maybe<J.Texture>) -> J.Core & (J.Frame & State):
  (frame, fudesumi) = r
  setup.done(core, fudesumi, upload(frame, J.Surface.create_checked(960, 480, 32, 32, J.Color.ORANGE(), J.Color.GOLD())))

def loaded(result: Result<&1, &1, J.Surface.IOError, J.Surface>) -> Maybe<J.Surface>:
  match result:
    case Fail{_}: None{}
    case Done{image}: Some{image}

# After InitWindow(800, 450): LoadImageRaw("resources/fudesumi.raw", 384, 512,
# R8G8B8A8, 0) and the checkerboard as textures, SetTargetFPS(60).
def setup(dir: String, +core: J.Core, frame: J.Frame) -> IO(J.Core & (J.Frame & State)):
  IO.bind(Result<&1, &1, J.Surface.IOError, J.Surface>, J.Core & (J.Frame & State), J.Surface.load_raw(dir ++ "resources/fudesumi.raw", 384, 512, 7, 0),
    result => IO.pure(J.Core & (J.Frame & State), setup.raw(core, upload(frame, loaded(result)))))

def run(args: List<String>) -> IO(Unit):
  J.Desktop.run(~State, ~program(M.AppleLibm{}), ~M.AppleLibm{}, "raylib [textures] example - raw data", 800, 450, J.Desktop.frames_arg(args),
    core => frame => setup("", core, frame))

def main() -> IO(Unit):
  IO.bind(List<String>, Unit, IO.args(), run)
