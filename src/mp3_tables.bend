# The Huffman table of a codebook (table_select): tabs from tabindex[tab].
def book(tab: U32) -> +List<U32>:
  match tab:
    case 0: tabs.at0()
    case 1: tabs.at32()
    case 2: tabs.at64()
    case 3: tabs.at98()
    case 4: tabs.at0()
    case 5: tabs.at132()
    case 6: tabs.at180()
    case 7: tabs.at218()
    case 8: tabs.at292()
    case 9: tabs.at364()
    case 10: tabs.at426()
    case 11: tabs.at538()
    case 12: tabs.at648()
    case 13: tabs.at746()
    case 14: tabs.at0()
    case 15: tabs.at1126()
    case 16: tabs.at1460()
    case 17: tabs.at1460()
    case 18: tabs.at1460()
    case 19: tabs.at1460()
    case 20: tabs.at1460()
    case 21: tabs.at1460()
    case 22: tabs.at1460()
    case 23: tabs.at1460()
    case 24: tabs.at1842()
    case 25: tabs.at1842()
    case 26: tabs.at1842()
    case 27: tabs.at1842()
    case 28: tabs.at1842()
    case 29: tabs.at1842()
    case 30: tabs.at1842()
    case _: tabs.at1842()

