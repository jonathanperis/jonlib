# Words of the atlas in order, loaded into a depth-9 Array.
def fill(rest: +List<U32>, +at: U32, words: Array<U32>) -> Array<U32>:
  match rest:
    case Nil{}: words
    case Con{word, tail}: fill(tail, (at + 1 : U32), Array.set(U32, words, at, word))

def chunks(n: Nat, +index: U32, words: Array<U32>) -> Array<U32>:
  match n:
    case 0n: words
    case 1n+rest: chunks(rest, (index + 1 : U32), fill(chunk(index), (index * 32 : U32), words))

def atlas() -> Array<U32>:
  chunks(16n, 0, Array.new(U32, 9n, 0))
