# Original additions: zlib, Copyright (c) 2026 Jonathan Peris.
# powf(2, y) under macOS arm64 libm, for the exponents jar_xm evaluates.
# Clang substitutes exp2f(y) for powf(2, y); on every word below, the two
# functions agreed, and the word stored is that common result. The words are
# the exponents of the xm-player and xm-music modules played through one loop
# and on for 8,000,000 samples, every linear period of the xm-pitch gate, and
# two more from the linear module after jar_xm_reset following 9,000 samples
# at 48,000 Hz. 179 of them differ from glibc's exp2_inline by one ulp
# (docs/MATH.md).
# The words are one static balanced tree, padded to the next power of two
# by repeating the last word. `at` follows each split and stops at the word;
# every other exponent is None. A match per word exhausts the compiler, and
# one flat spine overflows it.
# `wave` is sinf of jar_xm's 64 waveform steps on the same host.
# Imported as Apple: Apple.at, Apple.wave.
import Base

def float(+bits: U32) -> F32:
  U32{word} = bits
  F32{word}

