type Pow is Data:
  PowBin{bound: U32, lo: Pow, hi: Pow}
  PowTip{key: U32, value: U32}

def side(below: Bool, +lo: Pow, +hi: Pow) -> Pow:
  match below:
    case True{}: lo
    case False{}: hi

def tip(eq: Bool, +value: U32) -> Maybe<U32>:
  match eq:
    case True{}: Some{value}
    case False{}: None{}

