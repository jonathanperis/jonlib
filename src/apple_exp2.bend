# Sixteen steps: one per split of a 2^15-leaf tree, then the leaf.
def search(+fuel: Nat, +t: Pow, +bits: U32) -> Maybe<U32>:
  match fuel:
    case 0n:
      None{}
    case 1n+p:
      match t:
        case PowTip{+key, +value}:
          tip(U32.is_eq(bits, key), value)
        case PowBin{+bound, +lo, +hi}:
          search(p, side(U32.is_lt(bits, bound), lo, hi), bits)

def at.float(found: Maybe<U32>) -> Maybe<F32>:
  match found:
    case None{}: None{}
    case Some{+word}: Some{float(word)}

def at(+bits: U32) -> Maybe<F32>:
  at.float(search(16n, table(), bits))
