# Original additions: zlib, Copyright (c) 2026 Jonathan Peris.
# Altered Bend adaptation of Arm optimized-routines math/pow.c (log_inline
# and exp_inline, with the pow_log_data and exp_data tables), as glibc 2.39
# ships it on x86_64 (POW_LOG_TABLE_BITS 7, EXP_TABLE_BITS 7,
# TOINT_INTRINSICS 0). Copyright (c) 2018-2026 Arm Limited; MIT alternative,
# see LICENSES/arm-math.txt.
#
# Restricted to the one call stb_truetype's cubic solver makes:
# (float) pow((double) x, (double) (1.0f/3.0f)) for a float x that is a zero
# or positive and finite. The arithmetic is the __pow_fma ifunc variant's
# (-mfma -mavx2), read from the library's code: beside the source's own fma
# calls, kd*Ln2hi + logc, kd*Ln2lo + logctail, each a + r*b of the two
# polynomials, their sums with the ar2 and r2 products,
# ar3*(...) + (lo1 + lo2 + lo3 + lo4), y*lo + (...), InvLn2N*x + Shift,
# kd*NegLn2hiN + x, kd*NegLn2loN + (...) and scale*tmp + scale are one fma
# each. The SSE2 variant's doubles differ for about 1.5 million floats, and
# the floats they narrow to for none: tools/reference/glibc_pow compares both
# models with the library and with each other on every float (docs/MATH.md).
# Every binary64 operation goes through the exact helpers (each rounds once,
# to nearest even).
import Base
import ./binary64_fma.bend as F
import ./binary64_scaled.bend as S
import ./binary64_ops.bend as O
import ./binary64_narrow.bend as N

type V is Data:
  Ok{high: U32, low: U32}
  Bad{}

def lift(result: Maybe<F.Words>) -> V:
  match result:
    case Some{F.Words{high, low}}: Ok{high, low}
    case None{}: Bad{}

def mul(a: V, b: V) -> V:
  match a b:
    case Ok{+ah, +al} Ok{+bh, +bl}: lift(S.multiply(ah, al, bh, bl))
    case _ _: Bad{}

def add(a: V, b: V) -> V:
  match a b:
    case Ok{+ah, +al} Ok{+bh, +bl}: lift(S.add(ah, al, bh, bl))
    case _ _: Bad{}

def sub(a: V, b: V) -> V:
  match a b:
    case Ok{+ah, +al} Ok{+bh, +bl}: lift(S.subtract(ah, al, bh, bl))
    case _ _: Bad{}

def neg(a: V) -> V:
  match a:
    case Ok{high, low}: Ok{(high .^. 2147483648 : U32), low}
    case Bad{}: Bad{}

# a*b + c rounded once.
def fma(a: V, b: V, c: V) -> V:
  match a b c:
    case Ok{+ah, +al} Ok{+bh, +bl} Ok{+ch, +cl}: lift(S.fma(ah, al, bh, bl, ch, cl))
    case _ _ _: Bad{}

