def c3() -> V:
  Ok{1069897045, 1431655484}

def c4() -> V:
  Ok{1067799893, 3474402193}

def c5() -> V:
  Ok{1065423121, 1738854423}

def one() -> V:
  Ok{1072693248, 0}

def minus_one() -> V:
  Ok{3220176896, 0}

# (double) (1.0f/3.0f)
def third.exponent() -> V:
  Ok{1070945621, 1610612736}

# -----------------------------------------------------------------------------
# log_inline: y + tail = log(x)

type Log is Data:
  Log{hi: V, lo: V}

# r = z*invc - 1, then k*Ln2 + log(c) + log1p(r) in two parts.
def log.sum(+r: V, +kd: V, logc: V, logctail: V) -> Log:
  +t1 = fma(kd, ln2hi(), logc)
  +t2 = add(t1, r)
  +lo1 = fma(kd, ln2lo(), logctail)
  +lo2 = add(sub(t1, t2), r)
  +ar = mul(a0(), r)
  +ar2 = mul(r, ar)
  +hi = add(t2, ar2)
  +lo3 = fma(ar, r, neg(ar2))
  +lo4 = add(sub(t2, hi), ar2)
  +lo = fma(mul(r, ar2), fma(ar2, fma(ar2, fma(r, a6(), a5()), fma(r, a4(), a3())), fma(r, a2(), a1())), add(add(add(lo1, lo2), lo3), lo4))
  +y = add(hi, lo)
  Log{y, add(sub(hi, y), lo)}

def log.row(words: +List<U32>, +z: V, +kd: V) -> Log:
  match words:
    case Con{+ih, Con{+il, Con{+ch, Con{+cl, Con{+th, Con{+tl, _}}}}}}: log.sum(fma(z, Ok{ih, il}, minus_one()), kd, Ok{ch, cl}, Ok{th, tl})
    case _: Log{Bad{}, Bad{}}

# k of x = 2^k z as a double: `th` is the high word of ix - OFF, and k its
# arithmetic shift by 20 (|k| <= 2048, exact through F32).
def log.exponent(+th: U32) -> V:
  +negative = (th >= 2147483648 : U32)
  +magnitude = Bool.pick(U32, negative, ((((0 - th) + 1048575) >> 20n) : U32), ((th >> 20n) : U32))
  lift(O.checked_promote(F32.bits(Bool.pick(F32, negative, F32.neg(U32.to_f32(magnitude)), U32.to_f32(magnitude)))))

# log_inline of a positive normal double's words: OFF is 0x3fe6955500000000,
# so only the high word takes part in the interval and the exponent.
def log.at(+high: U32, +low: U32, +th: U32) -> Log:
  log.row(List.drop(&2, U32, log_table(), U32.to_nat((((th >> 13n) .&. 127) * 6 : U32))), Ok{(high - (th .&. 4293918720) : U32), low}, log.exponent(th))

def log(+high: U32, +low: U32) -> Log:
  log.at(high, low, (high - 1072076117 : U32))

# -----------------------------------------------------------------------------
# exp_inline: exp(x + xtail)

# tmp = tail + r + r2*(C2 + r*C3) + r2*r2*(C4 + r*C5); scale + scale*tmp.
def exp.sum(+r: V, +r2: V, tail: V, +scale: V) -> V:
  fma(scale, fma(fma(r, c5(), c4()), mul(r2, r2), fma(fma(r, c3(), c2()), r2, add(tail, r))), scale)

# The row of k % 128: the scale's bits take (k << 45) in their high word.
def exp.row(words: +List<U32>, +kl: U32, +r: V) -> V:
  match words:
    case Con{+th, Con{+tl, Con{+sh, Con{+sl, _}}}}: exp.sum(r, mul(r, r), Ok{th, tl}, Ok{(sh + (kl << 13n) : U32), sl})
    case _: Bad{}

# r = x + kd*NegLn2hiN + kd*NegLn2loN, then r += xtail.
def exp.rest(+x: V, xtail: V, +kd: V) -> V:
  add(fma(kd, negln2lon(), fma(kd, negln2hin(), x)), xtail)

# kd = InvLn2N*x + Shift, whose low word is k's, then kd -= Shift.
def exp.reduced(+x: V, xtail: V, kd: V) -> V:
  match kd:
    case Bad{}: Bad{}
    case Ok{+kh, +kl}: exp.row(List.drop(&2, U32, exp_table(), U32.to_nat(((kl .&. 127) * 4 : U32))), kl, exp.rest(x, xtail, sub(Ok{kh, kl}, shift())))

# 0: |x| < 2^-54, where the result is 1 + x. 1: the main path. 2: from 512
# up (an overflow, an underflow or the library's special case): no answer.
def exp.range(+high: U32) -> U32:
  +top = ((high >> 20n) .&. 2047 : U32)
  Bool.pick(U32, (top < 969 : U32), 0, Bool.pick(U32, (top < 1032 : U32), 1, 2))

def exp.at(range: U32, +x: V, xtail: V) -> V:
  match range:
    case 0: add(one(), x)
    case 1: exp.reduced(x, xtail, fma(invln2n(), x, shift()))
    case _: Bad{}

def exp(x: V, xtail: V) -> V:
  match x:
    case Bad{}: Bad{}
    case Ok{+high, +low}: exp.at(exp.range(high), Ok{high, low}, xtail)

# -----------------------------------------------------------------------------
# pow(x, y) of a positive normal x: ehi = y*hi, elo = y*lo + fma(y, hi, -ehi).

def pow.split(+y: V, +hi: V, lo: V, +ehi: V) -> V:
  exp(ehi, fma(y, lo, fma(y, hi, neg(ehi))))

def pow.logged(+y: V, logged: Log) -> V:
  Log{+hi, lo} = logged
  pow.split(y, hi, lo, mul(y, hi))

def narrow(value: V) -> Maybe<U32>:
  match value:
    case Ok{high, low}: N.checked(high, low)
    case Bad{}: None{}

def third.promoted(words: Maybe<F.Words>) -> Maybe<U32>:
  match words:
    case None{}: None{}
    case Some{F.Words{+high, +low}}: narrow(pow.logged(third.exponent(), log(high, low)))

# 0: a zero of either sign. 1: positive and finite. 2: negative, infinite
# or NaN.
def third.kind(+bits: U32) -> U32:
  Bool.pick(U32, U32.is_eq((bits .&. 2147483647 : U32), 0), 0, Bool.pick(U32, (bits < 2139095040 : U32), 1, 2))

def third.at(kind: U32, +bits: U32) -> Maybe<U32>:
  match kind:
    case 0: Some{0}
    case 1: third.promoted(O.checked_promote(bits))
    case _: None{}

# The bits of (float) pow((double) x, (double) (1.0f/3.0f)) as glibc 2.39's
# x86_64 pow gives it, for the bits of a float x: +0 for a zero of either
# sign (pow's x*x), the root's float for a positive finite x. None for a
# negative x (a NaN in C), an infinity (itself in C) and NaN.
def third(+bits: U32) -> Maybe<U32>:
  third.at(third.kind(bits), bits)
