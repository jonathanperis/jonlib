+// A nullary constructor is immutable. The C lane keeps it in STAT_IMG and
+// copies that image once; emitting it as the function body rebuilds it on
+// every JavaScript call. $: is the tag key, so any other $ is a binding and
+// stays a call. A literal with no call is safe to share.
+function js_held(expr: string): boolean {
+  if (expr.includes("(") || /\$(?!:)/.test(expr)) {
+    return false;
+  }
+  const bare = expr.replace(/"(?:\\.|[^"\\])*"/g, "");
+  return bare.includes("{") && /^[\s\d{} ,:.+\-eE$]*$/.test(bare);
+}
+
+function js_hoist(lines: string[], name: string): void {
+  const close = lines.length - 1;
+  if (lines[close] !== "}" || lines[close - 2] !== `function ${name}() {`) {
+    return;
+  }
+  const got = /^return (.+);$/.exec(lines[close - 1]);
+  const held = name + "$k";
+  if (got === null || FL.taken.has(held) || !js_held(got[1])) {
+    return;
+  }
+  FL.taken.add(held);
+  lines.splice(close - 2, 3, `const ${held} = ${got[1]};`,
+    `function ${name}() {`, `return ${held};`, "}");
+}
