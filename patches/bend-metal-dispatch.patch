@@ -0,0 +1,53 @@
+# Repeated calls to a shared flat helper must retain correct values when the
+# device compiler outlines their transitive expansion. Each loop saturates.
+# wide's own text passes the device spin threshold (DFAR). The shared helper
+# stays INLINE and gets a noinline wrapper only at the dispatch boundary.
+# The wrapper is Metal-only; CPU and CUDA alias the original helper.
+import Base
+
+def step(+x: F32) -> F32:
+  F32.clamp((x * 1.125 + 0.125 : F32), 0.0, 1.0)
+
+def block(x: F32) -> F32:
+  step(step(step(step(step(step(step(step(
+    step(step(step(step(step(step(step(step(x))))))))))))))))
+
+def heavy(x: F32) -> F32:
+  v = step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(x))))))))))))))))))))))))))))))))
+  step(step(v))
+
+def loop(n: Nat, x: F32) -> F32:
+  match n:
+    case 0n:
+      x
+    case 1n+k:
+      loop(k, heavy(block(x)))
+
+def tree(+depth: Nat, +x: F32) -> U32:
+  match depth:
+    case 0n:
+      F32.to_u32((loop(8n, x) * 1000.0 : F32))
+    case 1n+k:
+      a b = tree(k, x) tree(k, x)
+      (a + b : U32)
+
+# Own generated text past SPIN_FAR characters, so the device outlines it
+# directly and the dispatch budget does not also wrap it.
+def wide(x: F32) -> F32:
+  ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((x * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32) * 1.0000001 + 0.0000001 : F32)
+
+# wide of the tree's result is positive, so this adds 0 and the checksum stays.
+def use.sign(negative: Bool) -> U32:
+  match negative:
+    case True{}: 1
+    case False{}: 0
+
+def use(w: F32) -> U32:
+  use.sign(F32.is_lt(w, 0.0))
+
+def main() -> IO(Unit):
+  do IO<Unit>:
+    t : Nat <- IO.now()
+    IO.print(U32.show((tree!(4n, 0.0) + use(wide(F32.from_nat(t))) : U32)))
+
+#|16000
