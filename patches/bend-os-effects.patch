diff --git a/bend2/effs/path_stat.c b/bend2/effs/path_stat.c
new file mode 100644
index 0000000..d741e33
--- /dev/null
+++ b/bend2/effs/path_stat.c
@@ -0,0 +1,40 @@
+// Path
+// ====
+
+#include <sys/stat.h>
+
+// stat(2), links followed: the kind (1 a regular file, 2 a directory, 3
+// anything else), the size in bytes and the last modification in whole
+// seconds since the epoch (0 before it). A size past a Nat fails with
+// EOVERFLOW.
+static void path_stat_call(IoWork* w) {
+  struct stat st;
+  int n = stat(w->data, &st);
+  io_sys_end(w, n);
+  if (n == 0) {
+    w->code = (u64)st.st_size > NAT_IMM ? EOVERFLOW : 0;
+    w->word = S_ISREG(st.st_mode) ? 1 : S_ISDIR(st.st_mode) ? 2 : 3;
+    w->made = (intptr_t)st.st_size;
+    w->hand = st.st_mtime < 0 ? 0 : (intptr_t)st.st_mtime;
+  }
+}
+
+static Term path_stat_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code != 0 ? io_fail(e, w->code, NULL)
+    : io_done(e, io_tup(e, w->word, io_tup(e, (Term)(u64)w->made,
+      (Term)(u64)w->hand)));
+}
+
+Term path_stat_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return path_stat_pack(e, w);
+  }
+  return io_work(w, path_stat_call, path_stat_pack);
+}
+
+static void __attribute__((constructor)) path_stat_use(void) {
+  io_eff(CID(Path.stat), path_stat_run);
+}
diff --git a/bend2/effs/path_stat.js b/bend2/effs/path_stat.js
new file mode 100644
index 0000000..c2ac770
--- /dev/null
+++ b/bend2/effs/path_stat.js
@@ -0,0 +1,23 @@
+// Path
+// ====
+
+function path_stat(path) {
+  const name = io_bytes(path);
+  if (name.includes(0)) {
+    return io_fail(process.platform === "darwin" ? 92 : 84);
+  }
+  try {
+    const st = require("fs").statSync(Buffer.from(name), { bigint: true });
+    // A Nat is a host number, not a BigInt, and 2^48-1 still fits exactly.
+    if (st.size > 281474976710655n) {
+      return io_fail(process.platform === "darwin" ? 84 : 75);
+    }
+    const kind = st.isFile() ? 1 : st.isDirectory() ? 2 : 3;
+    const seconds = st.mtimeNs < 0n ? 0 : Number(st.mtimeNs / 1000000000n);
+    return io_done(io_tup(kind, Number(st.size), seconds));
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 5));
+  }
+}
+
+io_eff(CID(Path.stat), path_stat);
diff --git a/bend2/effs/process_path.c b/bend2/effs/process_path.c
new file mode 100644
index 0000000..5e5d32a
--- /dev/null
+++ b/bend2/effs/process_path.c
@@ -0,0 +1,34 @@
+// Process
+// =======
+
+#include <stdlib.h>
+#if defined(__APPLE__)
+#include <mach-o/dyld.h>
+#endif
+
+// The running program's own file as an absolute path, links resolved:
+// /proc/self/exe on Linux, _NSGetExecutablePath on macOS.
+Term process_path_run(Env e, Term* f, IoWork* w) {
+  char* path = NULL;
+#if defined(__APPLE__)
+  uint32_t n = 0;
+  _NSGetExecutablePath(NULL, &n);
+  char* raw = io_mem(malloc((size_t)n + 1));
+  if (_NSGetExecutablePath(raw, &n) == 0) {
+    path = realpath(raw, NULL);
+  }
+  free(raw);
+#else
+  path = realpath("/proc/self/exe", NULL);
+#endif
+  if (path == NULL) {
+    return io_fail(e, errno != 0 ? (u32)errno : ENOENT, NULL);
+  }
+  Term s = io_str(e, path, strlen(path));
+  free(path);
+  return io_done(e, s);
+}
+
+static void __attribute__((constructor)) process_path_use(void) {
+  io_eff(CID(Process.path), process_path_run);
+}
