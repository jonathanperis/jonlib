diff --git a/bend2/effs/path_remove.js b/bend2/effs/path_remove.js
new file mode 100644
index 0000000..c694acd
--- /dev/null
+++ b/bend2/effs/path_remove.js
@@ -0,0 +1,29 @@
+// Path
+// ====
+
+// remove(3): unlink, and rmdir where unlink refuses a directory (EISDIR on
+// Linux, EPERM on macOS).
+function path_remove(path) {
+  const name = io_bytes(path);
+  if (name.includes(0)) {
+    return io_fail(process.platform === "darwin" ? 92 : 84);
+  }
+  const fs = require("fs");
+  const at = Buffer.from(name);
+  try {
+    fs.unlinkSync(at);
+    return io_done({ $: CID(Unit) });
+  } catch (e) {
+    if (e.code !== "EISDIR" && e.code !== "EPERM") {
+      return io_fail(Math.abs(e.errno ?? 5));
+    }
+  }
+  try {
+    fs.rmdirSync(at);
+    return io_done({ $: CID(Unit) });
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 5));
+  }
+}
+
+io_eff(CID(Path.remove), path_remove);
