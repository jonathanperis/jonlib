diff --git a/bend2/effs/process_shell.c b/bend2/effs/process_shell.c
new file mode 100644
index 0000000..76f0ebf
--- /dev/null
+++ b/bend2/effs/process_shell.c
@@ -0,0 +1,39 @@
+// Process
+// =======
+
+#include <stdlib.h>
+#include <sys/wait.h>
+
+// system(3): `command` through /bin/sh -c, the program waiting for it; its
+// output goes where the program's goes (flushed first). The exit status, or
+// 128 plus the signal that ended it. This is not upstream Process.run, which
+// spawns a program with arguments and captures its output.
+static void process_shell_call(IoWork* w) {
+  int status = system(w->data);
+  if (status == -1) {
+    w->code = (u32)errno;
+    return;
+  }
+  w->code = 0;
+  w->word = WIFEXITED(status) ? (u32)WEXITSTATUS(status)
+    : WIFSIGNALED(status) ? 128 + (u32)WTERMSIG(status) : 255;
+}
+
+static Term process_shell_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code != 0 ? io_fail(e, w->code, NULL) : io_done(e, w->word);
+}
+
+Term process_shell_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return process_shell_pack(e, w);
+  }
+  io_sync();
+  return io_work(w, process_shell_call, process_shell_pack);
+}
+
+static void __attribute__((constructor)) process_shell_use(void) {
+  io_eff(CID(Process.shell), process_shell_run);
+}
diff --git a/bend2/effs/process_shell.js b/bend2/effs/process_shell.js
new file mode 100644
index 0000000..b516030
--- /dev/null
+++ b/bend2/effs/process_shell.js
@@ -0,0 +1,22 @@
+// Process
+// =======
+
+// /bin/sh -c, waiting for it, its output where the program's goes. Not
+// Process.run, which captures output and takes a program and arguments.
+function process_shell(command) {
+  if (io_bytes(command).includes(0)) {
+    return io_fail(process.platform === "darwin" ? 92 : 84);
+  }
+  const r = require("child_process")
+    .spawnSync("/bin/sh", ["-c", command], { stdio: "inherit" });
+  if (r.error) {
+    return io_fail(Math.abs(r.error.errno ?? 5));
+  }
+  if (r.status !== null) {
+    return io_done(r.status >>> 0);
+  }
+  const signal = require("os").constants.signals[r.signal];
+  return io_done(128 + (signal ?? 127));
+}
+
+io_eff(CID(Process.shell), process_shell);
diff --git a/tests/io/cwd_process.bend b/tests/io/cwd_process.bend
new file mode 100644
index 0000000..176c20d
--- /dev/null
+++ b/tests/io/cwd_process.bend
@@ -0,0 +1,97 @@
+# io (io_cwd_process): the working directory and the process: Dir.change
+# to "/" and Dir.current, Dir.change to a missing directory (ENOENT),
+# Process.path (a regular file), and Process.shell of a command that exits
+# with 3, of one that prints (its output lands before the status that
+# follows it) and of one that a signal ends (128 + SIGTERM).
+import Base
+
+law said:
+  for r: Result<&1, &1, (U32 & String), Unit>
+  IO(Unit)
+
+def said(r):
+  match r:
+    case Done{u}:
+      IO.print("ok")
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law text_said:
+  for r: Result<&1, &1, (U32 & String), String>
+  IO(Unit)
+
+def text_said(r):
+  match r:
+    case Done{text}:
+      IO.print(text)
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law status_said:
+  for r: Result<&1, &1, (U32 & String), U32>
+  IO(Unit)
+
+def status_said(r):
+  match r:
+    case Done{status}:
+      IO.print(U32.show(status))
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law kind_said:
+  for r: Result<&1, &1, (U32 & String), U32 & Nat & Nat>
+  IO(Unit)
+
+def kind_said(r):
+  match r:
+    case Done{stat}:
+      (kind, rest) = stat
+      IO.print(U32.show(kind))
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law self_said:
+  for r: Result<&1, &1, (U32 & String), String>
+  IO(Unit)
+
+def self_said(r):
+  match r:
+    case Done{path}:
+      IO.bind(Result<&1, &1, (U32 & String), U32 & Nat & Nat>, Unit, Path.stat(path), kind_said)
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    a : Result<&1, &1, (U32 & String), Unit> <- Dir.change("/")
+    a1 : Unit <- said(a)
+    b : Result<&1, &1, (U32 & String), String> <- Dir.current()
+    b1 : Unit <- text_said(b)
+    c : Result<&1, &1, (U32 & String), Unit> <- Dir.change("/no/such/dir")
+    c1 : Unit <- said(c)
+    d : Result<&1, &1, (U32 & String), String> <- Process.path()
+    d1 : Unit <- self_said(d)
+    e : Result<&1, &1, (U32 & String), U32> <- Process.shell("exit 3")
+    e1 : Unit <- status_said(e)
+    f : Result<&1, &1, (U32 & String), U32> <- Process.shell("echo from-sh")
+    f1 : Unit <- status_said(f)
+    g : Result<&1, &1, (U32 & String), U32> <- Process.shell("kill -TERM $$")
+    g1 : Unit <- status_said(g)
+    return 0
+
+#|ok
+#|/
+#|No such file or directory
+#|1
+#|3
+#|from-sh
+#|0
+#|143
diff --git a/tests/io/path_dir.bend b/tests/io/path_dir.bend
new file mode 100644
index 0000000..28186ca
--- /dev/null
+++ b/tests/io/path_dir.bend
@@ -0,0 +1,133 @@
+# io (io_path_dir): the path and directory surface end to end in a
+# directory of its own under /tmp: Dir.make, Dir.make again (EEXIST), a
+# file written in it, Path.stat of the file (its kind and size) and of the
+# directory (its kind), Dir.read, Path.rename, Dir.read again, Path.remove
+# of the file and then of the empty directory, and Path.stat of the path
+# removed (ENOENT). Whatever an earlier run left is removed first.
+import Base
+
+law said:
+  for r: Result<&1, &1, (U32 & String), Unit>
+  IO(Unit)
+
+def said(r):
+  match r:
+    case Done{u}:
+      IO.print("ok")
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law kind_said:
+  for kind: U32
+  for rest: Nat & Nat
+  IO(Unit)
+
+def kind_said(kind, rest):
+  match kind:
+    case 1:
+      (size, time) = rest
+      IO.print("1 " ++ Nat.show(size))
+    case _:
+      IO.print(U32.show(kind))
+
+law stat_said:
+  for r: Result<&1, &1, (U32 & String), U32 & Nat & Nat>
+  IO(Unit)
+
+def stat_said(r):
+  match r:
+    case Done{stat}:
+      (kind, rest) = stat
+      kind_said(kind, rest)
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law names_more:
+  for xs: List<String>
+  String
+
+def names_more(xs):
+  match xs:
+    case Nil{}:
+      ""
+    case Con{x, rest}:
+      "," ++ x ++ names_more(rest)
+
+law names_text:
+  for xs: List<String>
+  String
+
+def names_text(xs):
+  match xs:
+    case Nil{}:
+      ""
+    case Con{x, rest}:
+      x ++ names_more(rest)
+
+law names_said:
+  for r: Result<&1, &1, (U32 & String), List<String>>
+  IO(Unit)
+
+def names_said(r):
+  match r:
+    case Done{names}:
+      IO.print(names_text(names))
+    case Fail{error}:
+      (code, message) = error
+      IO.print(message)
+
+law write_go:
+  for w: File & Result<&1, &1, (U32 & String), Unit>
+  IO(Unit)
+
+def write_go(w):
+  (f, r) = w
+  do IO<Unit>:
+    u : Unit <- IO.pass(Unit, r)
+    File.close(f)
+
+law main:
+  IO(U32)
+
+def main():
+  do IO<U32>:
+    o : Result<&1, &1, (U32 & String), Unit> <- Path.remove("/tmp/bend_io_dir.tmp/bend_io_moved")
+    p : Result<&1, &1, (U32 & String), Unit> <- Path.remove("/tmp/bend_io_dir.tmp/bend_io_entry")
+    q : Result<&1, &1, (U32 & String), Unit> <- Path.remove("/tmp/bend_io_dir.tmp")
+    a : Result<&1, &1, (U32 & String), Unit> <- Dir.make("/tmp/bend_io_dir.tmp")
+    a1 : Unit <- said(a)
+    b : Result<&1, &1, (U32 & String), Unit> <- Dir.make("/tmp/bend_io_dir.tmp")
+    b1 : Unit <- said(b)
+    f : File <- IO.try(File, File.open("/tmp/bend_io_dir.tmp/bend_io_entry", "w"))
+    w : File & Result<&1, &1, (U32 & String), Unit> <- File.write(f, "bend")
+    w1 : Unit <- write_go(w)
+    s : Result<&1, &1, (U32 & String), U32 & Nat & Nat> <- Path.stat("/tmp/bend_io_dir.tmp/bend_io_entry")
+    s1 : Unit <- stat_said(s)
+    t : Result<&1, &1, (U32 & String), U32 & Nat & Nat> <- Path.stat("/tmp/bend_io_dir.tmp")
+    t1 : Unit <- stat_said(t)
+    l : Result<&1, &1, (U32 & String), List<String>> <- Dir.read("/tmp/bend_io_dir.tmp")
+    l1 : Unit <- names_said(l)
+    r : Result<&1, &1, (U32 & String), Unit> <- Path.rename("/tmp/bend_io_dir.tmp/bend_io_entry", "/tmp/bend_io_dir.tmp/bend_io_moved")
+    r1 : Unit <- said(r)
+    m : Result<&1, &1, (U32 & String), List<String>> <- Dir.read("/tmp/bend_io_dir.tmp")
+    m1 : Unit <- names_said(m)
+    x : Result<&1, &1, (U32 & String), Unit> <- Path.remove("/tmp/bend_io_dir.tmp/bend_io_moved")
+    x1 : Unit <- said(x)
+    y : Result<&1, &1, (U32 & String), Unit> <- Path.remove("/tmp/bend_io_dir.tmp")
+    y1 : Unit <- said(y)
+    z : Result<&1, &1, (U32 & String), U32 & Nat & Nat> <- Path.stat("/tmp/bend_io_dir.tmp")
+    z1 : Unit <- stat_said(z)
+    return 0
+
+#|ok
+#|File exists
+#|1 4
+#|2
+#|bend_io_entry
+#|ok
+#|bend_io_moved
+#|ok
+#|ok
+#|No such file or directory
