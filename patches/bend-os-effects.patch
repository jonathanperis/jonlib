diff --git a/bend2/effs/dir_change.c b/bend2/effs/dir_change.c
new file mode 100644
index 0000000..8cc415c
--- /dev/null
+++ b/bend2/effs/dir_change.c
@@ -0,0 +1,28 @@
+// Dir
+// ===
+
+#include <unistd.h>
+
+// chdir(2): the process's working directory, for every thread.
+static void dir_change_call(IoWork* w) {
+  io_sys_end(w, chdir(w->data));
+}
+
+static Term dir_change_pack(Env e, IoWork* w) {
+  free(w->data);
+  return w->code != 0 ? io_fail(e, w->code, NULL)
+    : io_done(e, term_pak(CID(Unit), 0));
+}
+
+Term dir_change_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return dir_change_pack(e, w);
+  }
+  return io_work(w, dir_change_call, dir_change_pack);
+}
+
+static void __attribute__((constructor)) dir_change_use(void) {
+  io_eff(CID(Dir.change), dir_change_run);
+}
