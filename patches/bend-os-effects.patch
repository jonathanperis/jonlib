diff --git a/bend2/effs/dir_read.c b/bend2/effs/dir_read.c
new file mode 100644
index 0000000..4bc934c
--- /dev/null
+++ b/bend2/effs/dir_read.c
@@ -0,0 +1,78 @@
+// Dir
+// ===
+
+#include <dirent.h>
+
+// The names in a directory in the order readdir(3) gives them, without "."
+// and "..": gathered on the helper thread, NUL-separated in w->text.
+static void dir_read_call(IoWork* w) {
+  DIR* dir = opendir(w->data);
+  if (dir == NULL) {
+    w->code = (u32)errno;
+    return;
+  }
+  u64   cap  = 256;
+  u64   used = 0;
+  char* buf  = io_mem(malloc(cap));
+  u32   count = 0;
+  for (;;) {
+    errno = 0;
+    struct dirent* entry = readdir(dir);
+    if (entry == NULL) {
+      w->code = (u32)errno;
+      break;
+    }
+    const char* name = entry->d_name;
+    if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
+      continue;
+    }
+    u64 n = strlen(name) + 1;
+    while (used + n > cap) {
+      cap *= 2;
+      buf = io_mem(realloc(buf, cap));
+    }
+    memcpy(buf + used, name, n);
+    used  += n;
+    count += 1;
+  }
+  closedir(dir);
+  w->text = buf;
+  w->size = used;
+  w->word = count;
+}
+
+static Term dir_read_pack(Env e, IoWork* w) {
+  free(w->data);
+  if (w->code != 0) {
+    free(w->text);
+    return io_fail(e, w->code, NULL);
+  }
+  u64* at = io_mem(malloc(sizeof(u64) * (w->word + 1)));
+  u64  p  = 0;
+  for (u32 i = 0; i < w->word; i += 1) {
+    at[i] = p;
+    p += strlen(w->text + p) + 1;
+  }
+  Term xs = term_pak(CID(Nil), 0);
+  for (u32 i = w->word; i > 0; i -= 1) {
+    const char* name = w->text + at[i - 1];
+    xs = io_node(e, CID(Con), io_str(e, name, strlen(name)), xs);
+  }
+  free(at);
+  free(w->text);
+  return io_done(e, xs);
+}
+
+Term dir_read_run(Env e, Term* f, IoWork* w) {
+  w->data = io_cstr(e, f[0], &w->size);
+  w->text = NULL;
+  if (io_nul(w->data, w->size)) {
+    w->code = EILSEQ;
+    return dir_read_pack(e, w);
+  }
+  return io_work(w, dir_read_call, dir_read_pack);
+}
+
+static void __attribute__((constructor)) dir_read_use(void) {
+  io_eff(CID(Dir.read), dir_read_run);
+}
diff --git a/bend2/effs/dir_read.js b/bend2/effs/dir_read.js
new file mode 100644
index 0000000..21ed88c
--- /dev/null
+++ b/bend2/effs/dir_read.js
@@ -0,0 +1,23 @@
+// Dir
+// ===
+
+function dir_read(path) {
+  const name = io_bytes(path);
+  if (name.includes(0)) {
+    return io_fail(process.platform === "darwin" ? 92 : 84);
+  }
+  try {
+    const names = require("fs")
+      .readdirSync(Buffer.from(name), { encoding: "buffer" });
+    let xs = { $: CID(Nil) };
+    for (let i = names.length; i > 0; i -= 1) {
+      const b = new Uint8Array(names[i - 1]);
+      xs = { $: CID(Con), head: io_text(b, b.length), tail: xs };
+    }
+    return io_done(xs);
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 5));
+  }
+}
+
+io_eff(CID(Dir.read), dir_read);
