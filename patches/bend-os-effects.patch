@@ -0,0 +1,17 @@
+// Dir
+// ===
+
+function dir_change(path) {
+  const name = io_bytes(path);
+  if (name.includes(0)) {
+    return io_fail(process.platform === "darwin" ? 92 : 84);
+  }
+  try {
+    process.chdir(io_text(name, name.length));
+    return io_done({ $: CID(Unit) });
+  } catch (e) {
+    return io_fail(Math.abs(e.errno ?? 5));
+  }
+}
+
+io_eff(CID(Dir.change), dir_change);
diff --git a/bend2/effs/dir_current.c b/bend2/effs/dir_current.c
new file mode 100644
index 0000000..52b1fbc
--- /dev/null
+++ b/bend2/effs/dir_current.c
@@ -0,0 +1,27 @@
+// Dir
+// ===
+
+#include <unistd.h>
+
+// getcwd(3), whatever its length.
+Term dir_current_run(Env e, Term* f, IoWork* w) {
+  u64 cap = 256;
+  for (;;) {
+    char* buf = io_mem(malloc(cap));
+    if (getcwd(buf, cap) != NULL) {
+      Term s = io_str(e, buf, strlen(buf));
+      free(buf);
+      return io_done(e, s);
+    }
+    u32 code = (u32)errno;
+    free(buf);
+    if (code != ERANGE) {
+      return io_fail(e, code, NULL);
+    }
+    cap *= 2;
+  }
+}
+
+static void __attribute__((constructor)) dir_current_use(void) {
+  io_eff(CID(Dir.current), dir_current_run);
+}
