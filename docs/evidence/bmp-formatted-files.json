      "definitions": {
        "Image.file.limit": {
          "source": "def Image.file.limit(kind: Image.FileKind) -> U32:\n  match kind:\n    case QoiFile{}: 83886102\n    case _: 1048576\n",
          "sha256": "348e86abf954318afae8c51e275c4e5ebe68340ce064add6b6aeb39aa1efae6e"
        },
        "Image.file.complete": {
          "source": "def Image.file.complete(n: Nat, bytes: +List<U32>) -> Bool:\n  match n bytes:\n    case 0n Nil{}: True{}\n    case 1n+rest Con{_, tail}: Image.file.complete(rest, tail)\n    case _ _: False{}\n",
          "sha256": "ccda3ffe2c9cd6b31ca9ac8a504adfc8a4dbb845d3b3d8a80d84a8dd8486b5f8"
        },
        "Image.file.payload": {
          "source": "def Image.file.payload(size: U32, result: Result<&1, &1, U32 & String, +List<U32>>) -> Result<&1, &1, Image.LoadError, +List<U32>>:\n  match result:\n    case Fail{Tuple{code, message}}: Fail{ImageFileError{code, message}}\n    case Done{+bytes}: Image.file.loaded(Image.file.complete(U32.to_nat(size), bytes), bytes)\n",
          "sha256": "f2054d9d89ea52a6d5a9de4443274f73b17c9eecd323d2e2bfb8bbdf8e795743"
        },
        "Image.file.read": {
          "source": "def Image.file.read(size: U32, result: File & Result<&1, &1, U32 & String, +List<U32>>) -> IO(Result<&1, &1, Image.LoadError, +List<U32>>):\n  (file, status) = result\n  do IO<Result<&1, &1, Image.LoadError, +List<U32>>>:\n    Unit <- File.close(file)\n    IO.pure(Result<&1, &1, Image.LoadError, +List<U32>>, Image.file.payload(size, status))\n",
          "sha256": "350524dd93bf9d0e164a0e68416fe1c1abd61e732c8d0cec3832874895dbafbf"
        },
        "Image.file.bounded": {
          "source": "def Image.file.bounded(valid: Bool, file: File, +size: U32) -> IO(Result<&1, &1, Image.LoadError, +List<U32>>):\n  match valid:\n    case False{}:\n      do IO<Result<&1, &1, Image.LoadError, +List<U32>>>:\n        Unit <- File.close(file)\n        IO.pure(Result<&1, &1, Image.LoadError, +List<U32>>, Fail{ImageDecodeError{UnsupportedImageSize{}}})\n    case True{}:\n      IO.bind(File & Result<&1, &1, U32 & String, +List<U32>>, Result<&1, &1, Image.LoadError, +List<U32>>,\n        File.read_bytes(file, size), Image.file.read(size))\n",
          "sha256": "bac958358b0a6c84367a6f4fbb0d5d992ef34bb5d9c2bb368d8e67769caa5c6b"
        },
        "Image.file.sized": {
          "source": "def Image.file.sized(limit: U32, result: File & Result<&1, &1, U32 & String, U32>) -> IO(Result<&1, &1, Image.LoadError, +List<U32>>):\n  match result:\n    case Tuple{file, Fail{error}}: Image.file.read(0, (file, Fail{error}))\n    case Tuple{file, Done{+size}}: Image.file.bounded((size <= limit : U32), file, size)\n",
          "sha256": "6ba5551aae13c291ec8bc257379a16a5244fe152eb96af08805f6aa694c18e4d"
        },
        "Image.file.opened": {
          "source": "def Image.file.opened(limit: U32, opened: Result<&1, &1, U32 & String, File>) -> IO(Result<&1, &1, Image.LoadError, +List<U32>>):\n  match opened:\n    case Fail{Tuple{code, message}}: IO.pure(Result<&1, &1, Image.LoadError, +List<U32>>, Fail{ImageFileError{code, message}})\n    case Done{file}:\n      IO.bind(File & Result<&1, &1, U32 & String, U32>, Result<&1, &1, Image.LoadError, +List<U32>>, File.size(file), Image.file.sized(limit))\n",
          "sha256": "108250379a5d39807792bd5a1d8d3b2dfbee930172eeb9c33c9dd064cb91f108"
        },
        "Image.file.bytes": {
          "source": "def Image.file.bytes(path: String, limit: U32) -> IO(Result<&1, &1, Image.LoadError, +List<U32>>):\n  IO.bind(Result<&1, &1, U32 & String, File>, Result<&1, &1, Image.LoadError, +List<U32>>, File.open(path, \"r\"), Image.file.opened(limit))\n",
          "sha256": "1c4ff92b7f34dc46ea7e5ec1156f9f349ddde835f8478282a00f1552b8a083fa"
        },
        "Image.file.decoded": {
          "source": "def Image.file.decoded(-A: Type, result: Result<&1, &1, Image.DecodeError, A>) -> Result<&1, &1, Image.LoadError, A>:\n  match result:\n    case Fail{error}: Fail{ImageDecodeError{error}}\n    case Done{image}: Done{image}\n",
          "sha256": "cd92509691e11e1ae00eae861ff4827fc5793a971645bc480b04cedf3c99c72f"
        },
        "Image.Formatted.bmp.file.loaded": {
          "source": "def Image.Formatted.bmp.file.loaded(result: Result<&1, &1, Image.LoadError, +List<U32>>) -> IO(Result<&1, &1, Image.LoadError, Image.Formatted>):\n  match result:\n    case Fail{error}: IO.pure(Result<&1, &1, Image.LoadError, Image.Formatted>, Fail{error})\n    case Done{bytes}:\n      IO.pure(Result<&1, &1, Image.LoadError, Image.Formatted>, Image.file.decoded(Image.Formatted, Image.Formatted.decode_bmp(bytes)))\n",
          "sha256": "95d22e7abde239660995658a2fbbc93fd2f9bb2df6568f884f387b846798ff2f"
